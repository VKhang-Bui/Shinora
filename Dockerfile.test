# Dockerfile dành riêng cho kiểm thử tự động toàn diện
FROM node:22-bookworm-slim

WORKDIR /app

# Copy toàn bộ mã nguồn dự án vào container
COPY package.json ./
COPY backend ./backend
COPY frontend ./frontend
COPY api ./api
COPY tests ./tests
COPY index.html ./

# Thiết lập biến môi trường CSDL test độc lập
ENV NODE_ENV=test
ENV PORT=3000
ENV DB_PATH=/tmp/test_deadlines.sqlite

# Cài đặt curl để kiểm tra nếu cần
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Chạy test:
# 1. Nạp test.sqlite từ schema test_data.sql vào /tmp
# 2. Khởi động server test chạy trên port 3000 với CSDL test
# 3. Chạy toàn bộ 25+ bài test tự động
CMD ["sh", "-c", "node tests/setup_test_db.js && node backend/server.js & sleep 1 && node tests/run_tests.js"]
