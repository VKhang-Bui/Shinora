{
  "version": 2,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sw.js", "destination": "/frontend/sw.js" },
    { "source": "/api/push/:action", "destination": "/api/push.js?action=:action" },
    { "source": "/api/push", "destination": "/api/push.js" },
    { "source": "/api/auth/login", "destination": "/api/auth.js" },
    { "source": "/api/users", "destination": "/api/users.js" },
    { "source": "/api/deadlines/:id", "destination": "/api/deadlines.js?id=:id" },
    { "source": "/api/deadlines", "destination": "/api/deadlines.js" },
    { "source": "/api/feedbacks", "destination": "/api/feedbacks.js" },
    { "source": "/frontend/pages/deadline.css", "destination": "/frontend/pages/deadline/deadline.css" },
    { "source": "/frontend/pages/deadline.js", "destination": "/frontend/pages/deadline/deadline.js" },
    { "source": "/deadline.css", "destination": "/frontend/pages/deadline/deadline.css" },
    { "source": "/deadline.js", "destination": "/frontend/pages/deadline/deadline.js" },
    { "source": "/shared/(.*)", "destination": "/frontend/shared/$1" },
    { "source": "/frontend/shared/(.*)", "destination": "/frontend/shared/$1" },
    { "source": "/deadline", "destination": "/frontend/pages/deadline/index.html" },
    { "source": "/frontend/pages/deadline", "destination": "/frontend/pages/deadline/index.html" }
  ]
}
